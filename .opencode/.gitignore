# opencode install artifacts — generated by opencode's startup `bun install`
# (or `bun install --frozen-lockfile`); never committed.
node_modules
bun.lock

# Local coordination identity — per-machine/per-session, never committed. Copy
# coord.conf.example to coord.conf and fill in your values (or use COORD_* env).
coord.conf

# package.json IS committed: it pins the @opencode-ai/plugin TYPE version used by
# the plugins in plugins/. The plugins import types only (`import type`), so the
# dependency is never required at runtime — but the declared version MUST carry the
# `./v2/promise` export the V2 plugins type against. `scripts/check-opencode-coord.mjs`
# asserts the declared version, and (when `bun install` has run) that the installed
# package exports `./v2/promise`.
